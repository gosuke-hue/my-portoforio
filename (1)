<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>阿部寛風 公式ホームページ</title>
    <style>
        body {
            font-family: "ＭＳ Ｐゴシック", sans-serif;
            background-color: #ffffff;
            color: #000000;
            margin: 20px;
        }
        h1 {
            font-size: 22px;
            border-bottom: 2px solid #000000;
            padding-bottom: 5px;
        }
        table {
            border-collapse: collapse;
            width: 100%;
            max-width: 650px;
        }
        td {
            padding: 10px;
            vertical-align: top;
        }
        a {
            color: #0000ff;
        }
    </style>
</head>
<body>

    <h1>阿部 寛のホームページ</h1>

    <table border="1" cellspacing="0" cellpadding="5">
        <tr>
            <td width="30%">
                <p><strong>メニュー</strong></p>
                <ul>
                    <li><a href="#profile">プロフィール</a></li>
                    <li><a href="#news">最新情報</a></li>
                </ul>
            </td>
            <td width="70%">
                <h2 id="profile">プロフィール</h2>
                <p>生年月日：1964年6月22日</p>
                <p>血液型：A型</p>
                
                <h2 id="news">最新情報</h2>
                <p>ドラマ・映画などで活躍中。</p>
            </td>
        </tr>
    </table>

</body>
</html>
